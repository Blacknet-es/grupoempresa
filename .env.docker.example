# Copy to .env in the repository root for local Docker Compose use.
APP_ENV=dev
APP_SECRET=replace-this-with-a-random-secret

# Local MariaDB connection (keep credentials aligned with MYSQL_* below).
DATABASE_URL=mysql://symfony_user:symfony_pass@db:3306/symfony_db?serverVersion=mariadb-10.5.0
MYSQL_ROOT_PASSWORD=replace-this-root-password
MYSQL_DATABASE=symfony_db
MYSQL_USER=symfony_user
MYSQL_PASSWORD=symfony_pass

# Local one-time restore from ./dbbackup/backup.sql.
# In Coolify, mount persistent storage containing backup.sql at /dbbackup.
DB_BACKUP_PATH=/dbbackup/backup.sql
# Non-empty databases are rejected unless this is deliberately enabled.
DB_BACKUP_IMPORT_ALLOW_NONEMPTY=0

# Production uses Coolify environment variables: set APP_ENV=prod, APP_SECRET,
# and DATABASE_URL there. Do not use the development credentials above.
# The SQL dump is intentionally excluded from Git and the Docker image.
# For persistent uploads in Coolify, mount volumes at:
# /var/www/html/public/uploads and /var/www/html/documents
