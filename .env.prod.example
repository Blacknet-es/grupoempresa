# Set these as runtime environment variables/secrets in Coolify; do not copy this
# file into the image or commit a filled-in production environment file.
APP_ENV=prod
APP_SECRET=generate-a-unique-secret-for-production

# Use the internal hostname and credentials of the Coolify database service.
# URL-encode special characters in the username/password.
DATABASE_URL=mysql://DB_USER:URL_ENCODED_PASSWORD@COOLIFY_DB_HOST:3306/DB_NAME?serverVersion=mariadb-10.5.0

# Optional: set these only when mounting a backup at /dbbackup/backup.sql.
DB_BACKUP_PATH=/dbbackup/backup.sql
DB_BACKUP_IMPORT_ALLOW_NONEMPTY=0
