<script>
    $(window).on('load', function () {
        setTimeout(function() {
            $('.loading').fadeOut(400, function() {
                $(this).remove();
                $('.cookies').fadeIn(300);
            });
        }, 400);
    });
</script>
<link rel="stylesheet" type="text/css" href="//cdnjs.cloudflare.com/ajax/libs/cookieconsent2/3.0.3/cookieconsent.min.css" />
