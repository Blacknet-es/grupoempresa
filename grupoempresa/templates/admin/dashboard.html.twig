{% extends 'TrendixAdminBundle::layout.html.twig' %}

{% block content %}
    <section>
        <header class="content__title">
            <h1>Dashboard</h1>

            <div class="actions">
                <a href="" class="actions__item zmdi zmdi-trending-up"></a>
                <a href="" class="actions__item zmdi zmdi-check-all"></a>

                <div class="dropdown actions__item">
                    <i data-toggle="dropdown" class="zmdi zmdi-more-vert"></i>
                    <div class="dropdown-menu dropdown-menu-right">
                        <a href="" class="dropdown-item">Refresh</a>
                        <a href="" class="dropdown-item">Manage Widgets</a>
                        <a href="" class="dropdown-item">Settings</a>
                    </div>
                </div>
            </div>
        </header>

        <div class="row quick-stats">
            <div class="col-sm-6 col-md-3">
                <div class="quick-stats__item bg-blue">
                    <div class="quick-stats__info">
                        <h2>{{ socios_activos }}</h2>
                        <small>Socios Activos</small>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div class="quick-stats__item bg-red">
                    <div class="quick-stats__info">
                        <h2>{{ siguiente_num_socio }}</h2>
                        <small>Siguiente Número de Socio</small>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div style="cursor: pointer;" onclick="window.location.href='{{ path('socio_new') }}'" class="quick-stats__item bg-green">
                    <div class="quick-stats__info">
                        <h2><i class="zmdi zmdi-plus"></i></h2>
                        <small>Registrar Nuevo Socio</small>
                    </div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div style="cursor: pointer;" onclick="window.location.href='{{ path('file_new') }}'" class="quick-stats__item bg-purple">
                    <div class="quick-stats__info">
                        <h2><i class="zmdi zmdi-plus"></i></h2>
                        <small>Subir Nuevo Documento</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="content__title">
        <h1>Ficheros</h1>
        </div>
        <div class="row">
            {% for f in ficheros %}
            <div class="col-4"><a target="_blank" style="display: block; border: 1px solid #dfdfd5; background: #efefe5; padding: 4px 8px;" href="{{ asset('uploads/files/' ~ f.url) }}">{{ f.nombre }}</a></div>
            {% endfor %}
        </div>
        {#
        <div class="row quick-stats">
            <div class="col-sm-6 col-md-3">
                <div class="quick-stats__item bg-blue">
                    <div class="quick-stats__info">
                        <h2>3,500€</h2>
                        <small>Facturación en el último més</small>
                    </div>

                    <div class="quick-stats__chart sparkline-bar-stats"><canvas width="58" height="36" style="display: inline-block; width: 58px; height: 36px; vertical-align: top;"></canvas></div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div class="quick-stats__item bg-amber">
                    <div class="quick-stats__info">
                        <h2>45,530€</h2>
                        <small>Facturación total</small>
                    </div>

                    <div class="quick-stats__chart sparkline-bar-stats"><canvas width="58" height="36" style="display: inline-block; width: 58px; height: 36px; vertical-align: top;"></canvas></div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div class="quick-stats__item bg-purple">
                    <div class="quick-stats__info">
                        <h2>124</h2>
                        <small>Total de Facturas</small>
                    </div>

                    <div class="quick-stats__chart sparkline-bar-stats"><canvas width="58" height="36" style="display: inline-block; width: 58px; height: 36px; vertical-align: top;"></canvas></div>
                </div>
            </div>

            <div class="col-sm-6 col-md-3">
                <div class="quick-stats__item bg-red">
                    <div class="quick-stats__info">
                        <h2>5,670€</h2>
                        <small>Pendiente de Cobro</small>
                    </div>

                    <div class="quick-stats__chart sparkline-bar-stats"><canvas width="58" height="36" style="display: inline-block; width: 58px; height: 36px; vertical-align: top;"></canvas></div>
                </div>
            </div>
        </div>
        #}
    </section>
{% endblock %}