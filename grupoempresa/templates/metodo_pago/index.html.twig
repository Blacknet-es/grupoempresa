<!DOCTYPE html>

<title>MetodoPago index</title>

{% block body %}
    <h1>MetodoPago index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nombre</th>
                <th>Clave</th>
                <th>Periodo</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for metodo_pago in metodo_pagos %}
            <tr>
                <td>{{ metodo_pago.id }}</td>
                <td>{{ metodo_pago.nombre }}</td>
                <td>{{ metodo_pago.clave }}</td>
                <td>{{ metodo_pago.periodo }}</td>
                <td>
                    <a href="{{ path('metodo_pago_show', {'id': metodo_pago.id}) }}">show</a>
                    <a href="{{ path('metodo_pago_edit', {'id': metodo_pago.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="5">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('metodo_pago_new') }}">Create new</a>
{% endblock %}
